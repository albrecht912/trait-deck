# Godot 4 .gitignore

# Godot-specific ignores
.godot/

# Exported projects
/android/
/ios/
/html5/
/linux/
/macos/
/windows/
/web/

# Import cache and generated files
*.import
*.translation

# Mono/C# specific
.mono/
data_*/
mono_crash.*.json

# Editor-specific files
*.tmp
*.bak
*.swp
*~.nib
local.properties

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
